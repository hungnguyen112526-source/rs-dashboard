# Sao chép thành .streamlit/secrets.toml (chạy máy) hoặc dán vào Settings → Secrets (Streamlit Cloud). KHÔNG đưa file thật lên GitHub.

# --- Tài khoản quản trị (tạo tự động ở lần chạy đầu) ---
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "doi-mat-khau-manh-o-day-123"
ADMIN_EMAIL = ""

# --- Lưu tài khoản/phiên bền vững (Upstash Redis, REST API) ---
UPSTASH_REDIS_REST_URL = ""
UPSTASH_REDIS_REST_TOKEN = ""

# --- Trợ lý AI (Gemini, gói miễn phí) ---
# Lấy key tại https://aistudio.google.com/apikey . Để trống thì người dùng phải tự nhập key riêng ở nút ⚙️ trong khung chat.
GEMINI_API_KEY = ""
# Danh sách model theo thứ tự ưu tiên; gặp lỗi 429/quá tải sẽ tự chuyển sang model kế. Đối chiếu tên và hạn mức
# trong Google AI Studio (mục Rate limits) rồi chỉnh cho khớp.
GEMINI_MODELS = "gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash"
# Giới hạn lượt (mỗi câu hỏi tốn 2-4 request vì AI gọi công cụ lấy dữ liệu). Chỉ áp dụng khi dùng key chung.
AI_USER_PER_HOUR = 15      # số câu hỏi / người / giờ
AI_USER_PER_DAY = 40       # số câu hỏi / người / ngày
AI_GLOBAL_RPM = 8          # số request Gemini / phút cho cả hệ thống (đặt thấp hơn RPM của model)
AI_GLOBAL_RPD = 1200       # số request Gemini / ngày cho cả hệ thống (đặt thấp hơn RPD của model)
